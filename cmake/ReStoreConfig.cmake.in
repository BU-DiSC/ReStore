# ReStoreConfig.cmake
# This file is generated by CMake

@PACKAGE_INIT@

set(ReStore_VERSION @PROJECT_VERSION@)

# Find the restore executable
find_program(ReStore_EXECUTABLE restore
    PATHS @CMAKE_INSTALL_PREFIX@/bin
    NO_DEFAULT_PATH
)

# Find policy executables
set(ReStore_POLICY_EXECUTABLES
    Run_RL Run_LFU Run_LRU Run_LRFU Run_EXD Run_TEMP 
    Run_static Run_ideal Run_LogiReg Run_XGBfast
)

foreach(POLICY ${ReStore_POLICY_EXECUTABLES})
    find_program(ReStore_${POLICY}_EXECUTABLE ${POLICY}
        PATHS @CMAKE_INSTALL_PREFIX@/bin
        NO_DEFAULT_PATH
    )
    if(ReStore_${POLICY}_EXECUTABLE)
        list(APPEND ReStore_EXECUTABLES ${ReStore_${POLICY}_EXECUTABLE})
    endif()
endforeach()

# Set data directories (users provide their own workload data)
# set(ReStore_WORKLOAD_DIR @CMAKE_INSTALL_PREFIX@/share/ReStore/workload)
# set(ReStore_RESULTS_DIR @CMAKE_INSTALL_PREFIX@/share/ReStore/results)

# Check if all components are found
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(ReStore
    REQUIRED_VARS ReStore_EXECUTABLE
    VERSION_VAR ReStore_VERSION
)

if(ReStore_FOUND)
    set(ReStore_FOUND TRUE)
    message(STATUS "Found ReStore: ${ReStore_EXECUTABLE}")
    message(STATUS "  Version: ${ReStore_VERSION}")
    message(STATUS "  Note: Provide your own workload data when running experiments")
else()
    set(ReStore_FOUND FALSE)
    message(STATUS "ReStore not found")
endif()
